generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  phone          String?
  email          String?
  address        String?
  gstin          String?
  logoUrl        String?
  plan           TenantPlan          @default(FREE)
  settings       Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  bills          Bill[]
  templates      BillTemplate[]
  items          ItemCatalog[]
  journalEntries JournalEntry[]
  measurements   MeasurementUpload[]
  parties        Party[]
  payments       Payment[]
  users          User[]
}

model User {
  id            String              @id @default(cuid())
  name          String
  email         String?
  phone         String?
  password      String
  role          Role                @default(CUSTOMER)
  isActive      Boolean             @default(true)
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenantId      String
  authThrottles AuthThrottle[]
  billsCreated  Bill[]
  measurements  MeasurementUpload[]
  payments      Payment[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model ApiRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model AuthThrottle {
  id             String            @id @default(cuid())
  scope          AuthThrottleScope
  throttleKey    String
  userId         String?
  failureCount   Int               @default(0)
  firstFailureAt DateTime?
  lastAttemptAt  DateTime?
  blockedUntil   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation(fields: [userId], references: [id])

  @@unique([scope, throttleKey])
  @@index([blockedUntil])
  @@index([userId])
}

model BillTemplate {
  id        String   @id @default(cuid())
  name      String
  columns   Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  tenantId  String
  bills     Bill[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ItemCatalog {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  hsnCode   String?
  unit      String   @default("pcs")
  rate      Float    @default(0)
  taxRate   Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, name])
}

model Bill {
  id              String       @id @default(cuid())
  billNumber      String
  templateId      String
  customerName    String
  customerPhone   String?
  customerAddress String?
  gstin           String?
  rows            Json
  notes           String?
  terms           String?
  subtotal        Float
  taxPercent      Float        @default(0)
  taxAmount       Float        @default(0)
  grandTotal      Float
  status          BillStatus   @default(DRAFT)
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  isDeleted       Boolean      @default(false)
  partyId         String?
  tenantId        String
  creator         User         @relation(fields: [createdBy], references: [id])
  party           Party?       @relation(fields: [partyId], references: [id])
  template        BillTemplate @relation(fields: [templateId], references: [id])
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  payments        Payment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([tenantId, partyId])
  @@index([tenantId, status])
}

model Party {
  id             String              @id @default(cuid())
  name           String
  type           PartyType
  phone          String?
  email          String?
  address        String?
  gstin          String?
  openingBalance Float               @default(0)
  currentBalance Float               @default(0)
  isActive       Boolean             @default(true)
  isDeleted      Boolean             @default(false)
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenantId       String
  bills          Bill[]
  measurements   MeasurementUpload[]
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  payments       Payment[]

  @@index([tenantId])
  @@index([tenantId, type])
}

model Payment {
  id           String        @id @default(cuid())
  partyId      String
  direction    PayDirection
  amount       Float
  date         DateTime
  mode         PaymentMode
  status       PaymentStatus @default(COMPLETED)
  referenceNo  String?
  linkedBillId String?
  notes        String?
  receiptUrl   String?
  createdBy    String
  createdAt    DateTime      @default(now())
  isDeleted    Boolean       @default(false)
  updatedAt    DateTime      @updatedAt
  tenantId     String
  creator      User          @relation(fields: [createdBy], references: [id])
  linkedBill   Bill?         @relation(fields: [linkedBillId], references: [id])
  party        Party         @relation(fields: [partyId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, partyId])
  @@index([tenantId, direction])
}

model JournalEntry {
  id          String        @id @default(cuid())
  tenantId    String
  entryDate   DateTime
  narration   String
  voucherType VoucherType
  billId      String?
  purchaseId  String?
  paymentId   String?
  isBalanced  Boolean       @default(false)
  totalDebit  Float         @default(0)
  totalCredit Float         @default(0)
  createdBy   String
  createdAt   DateTime      @default(now())
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  lines       JournalLine[]

  @@index([tenantId])
  @@index([tenantId, entryDate])
  @@index([tenantId, voucherType])
  @@index([billId])
  @@index([purchaseId])
  @@index([paymentId])
}

model JournalLine {
  id          String       @id @default(cuid())
  journalId   String
  accountCode String
  accountName String
  tallyGroup  String
  partyId     String?
  partyName   String?
  debit       Float        @default(0)
  credit      Float        @default(0)
  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([accountCode])
}

model MediaAsset {
  id                String             @id @default(cuid())
  kind              MediaAssetKind
  storageProvider   String
  storageKey        String             @unique
  mimeType          String
  bytes             Int
  originalName      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  measurementPhotos MeasurementPhoto[]
}

model MeasurementPhoto {
  id            String            @id @default(cuid())
  measurementId String
  assetId       String
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  asset         MediaAsset        @relation(fields: [assetId], references: [id])
  measurement   MeasurementUpload @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId, sortOrder])
  @@index([assetId])
}

model MeasurementUpload {
  id           String             @id @default(cuid())
  customerId   String
  label        String
  roomName     String?
  doorType     String?
  notes        String?
  photosLegacy Json               @map("photos")
  status       MeasurementStatus  @default(UPLOADED)
  reviewedBy   String?
  reviewNotes  String?
  isDeleted    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  partyId      String?
  tenantId     String
  photoAssets  MeasurementPhoto[]
  customer     User               @relation(fields: [customerId], references: [id])
  party        Party?             @relation(fields: [partyId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum TenantPlan {
  FREE
  PRO
}

enum Role {
  ADMIN
  STAFF
  ACCOUNTANT
  CUSTOMER
}

enum AuthThrottleScope {
  IP
  CREDENTIAL
}

enum BillStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum PartyType {
  VENDOR
  CUSTOMER
}

enum PayDirection {
  INCOMING
  OUTGOING
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  EXPECTED
  COMPLETED
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
}

enum MediaAssetKind {
  COMPANY_LOGO
  MEASUREMENT_PHOTO
}

enum MeasurementStatus {
  UPLOADED
  PENDING
  REVIEWED
  IN_PRODUCTION
  COMPLETED
}
