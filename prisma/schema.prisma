generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  phone          String?
  email          String?
  address        String?
  gstin          String?
  logoUrl        String?
  plan           TenantPlan          @default(FREE)
  settings       Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  auditLogs      AuditLog[]
  bills          Bill[]
  templates      BillTemplate[]
  items          ItemCatalog[]
  journalEntries JournalEntry[]
  measurements   MeasurementUpload[]
  parties        Party[]
  payments       Payment[]
  users          User[]
  importJobs     ImportJob[]
}

model User {
  id            String              @id @default(cuid())
  name          String
  email         String?
  phone         String?
  password      String
  role          Role                @default(CUSTOMER)
  isActive      Boolean             @default(true)
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenantId      String
  authThrottles AuthThrottle[]
  billsCreated  Bill[]
  measurements  MeasurementUpload[]
  payments      Payment[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model ApiRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model AuthThrottle {
  id             String            @id @default(cuid())
  scope          AuthThrottleScope
  throttleKey    String
  userId         String?
  failureCount   Int               @default(0)
  firstFailureAt DateTime?
  lastAttemptAt  DateTime?
  blockedUntil   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation(fields: [userId], references: [id])

  @@unique([scope, throttleKey])
  @@index([blockedUntil])
  @@index([userId])
}

/**
 * AuditLog — MCA-mandated Edit Log (GSR 247(E), effective April 1 2023)
 * Append-only: rows are NEVER updated or deleted.
 * Captures every CREATE / UPDATE / DELETE on accounting-relevant entities.
 * Indexed for tenant-scoped audit queries and date-range exports.
 */
model AuditLog {
  id         String    @id @default(cuid())
  tenantId   String
  entityType String // "Bill" | "Payment" | "Party" | "JournalEntry"
  entityId   String // PK of the changed record
  userId     String? // actor who triggered the change — null for system/cron actors
  actorType  ActorType @default(USER) // distinguishes human vs automated actions
  action     String // "CREATE" | "UPDATE" | "DELETE"
  fieldName  String? // null for whole-record events (CREATE / DELETE)
  oldValue   String? // JSON-serialised previous value
  newValue   String? // JSON-serialised next value
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

model BillTemplate {
  id        String   @id @default(cuid())
  name      String
  columns   Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  tenantId  String
  bills     Bill[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ItemCatalog {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  hsnCode   String?
  unit      String   @default("pcs")
  rate      Decimal  @default(0) @db.Decimal(19, 4) // [B3] Float → Decimal
  taxRate   Decimal? @db.Decimal(5, 2) // [B3] Float → Decimal
  cessRate  Decimal? @db.Decimal(5, 2) // GST Cess % (tobacco, aerated drinks, luxury goods)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, name])
}

model Bill {
  id              String         @id @default(cuid())
  billNumber      String
  templateId      String
  customerName    String
  customerPhone   String?
  customerAddress String?
  gstin           String?
  rows            Json
  notes           String?
  terms           String?
  subtotal        Decimal        @db.Decimal(19, 4) // [B3] Float → Decimal
  taxPercent      Decimal        @default(0) @db.Decimal(5, 2) // [B3] Float → Decimal
  taxAmount       Decimal        @default(0) @db.Decimal(19, 4) // [B3] Float → Decimal
  cessAmount      Decimal        @default(0) @db.Decimal(19, 4) // GST Cess amount charged on this bill
  grandTotal      Decimal        @db.Decimal(19, 4) // [B3] Float → Decimal
  placeOfSupply   String? // [B1] GSTR-1 mandatory field
  hsnCode         String? // [ADDED] Fallback HSN wrapper for older bills
  status          BillStatus     @default(DRAFT)
  createdBy       String
  createdAt       DateTime       @default(now())
  date            DateTime       @default(now()) // Custom issue date/voucher date
  updatedAt       DateTime       @updatedAt
  isDeleted       Boolean        @default(false)
  partyId         String?
  tenantId        String
  isInterState    Boolean        @default(false)
  creator         User           @relation(fields: [createdBy], references: [id])
  party           Party?         @relation(fields: [partyId], references: [id])
  template        BillTemplate   @relation(fields: [templateId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  journalEntries  JournalEntry[]
  payments        Payment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([tenantId, partyId])
  @@index([tenantId, status])
}

model Party {
  id             String              @id @default(cuid())
  name           String
  type           PartyType
  phone          String?
  email          String?
  address        String?
  gstin          String?
  openingBalance Decimal             @default(0) @db.Decimal(19, 4) // [B3] Float → Decimal
  currentBalance Decimal             @default(0) @db.Decimal(19, 4) // [B3] Float → Decimal
  isActive       Boolean             @default(true)
  isDeleted      Boolean             @default(false)
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenantId       String
  bills          Bill[]
  measurements   MeasurementUpload[]
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  payments       Payment[]

  @@unique([tenantId, name]) // [B2] prevents TOCTOU duplicate party on Tally import
  @@index([tenantId])
  @@index([tenantId, type])
}

model Payment {
  id           String        @id @default(cuid())
  partyId      String
  direction    PayDirection
  amount       Decimal       @db.Decimal(19, 4) // [B3] Float → Decimal
  date         DateTime
  mode         PaymentMode
  status       PaymentStatus @default(COMPLETED)
  referenceNo  String?
  linkedBillId String?
  notes        String?
  receiptUrl   String?
  createdBy    String
  createdAt    DateTime      @default(now())
  isDeleted    Boolean       @default(false)
  updatedAt    DateTime      @updatedAt
  tenantId     String
  creator      User          @relation(fields: [createdBy], references: [id])
  linkedBill   Bill?         @relation(fields: [linkedBillId], references: [id])
  party        Party         @relation(fields: [partyId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, partyId])
  @@index([tenantId, direction])
}

model JournalEntry {
  id              String        @id @default(cuid())
  tenantId        String
  entryDate       DateTime
  narration       String
  voucherType     VoucherType
  billId          String?
  purchaseId      String?
  paymentId       String?
  // [CRITICAL-1] Tracks whether this entry was modified in the cloud post-import
  syncState       SyncState     @default(SYNCED)
  isBalanced      Boolean       @default(false)
  totalDebit      Decimal       @default(0) @db.Decimal(19, 4) // [B4] Float → Decimal for precision
  totalCredit     Decimal       @default(0) @db.Decimal(19, 4) // [B4] Float → Decimal for precision
  /**
   * remoteId — Tally <REMOTEID> / <GUID> value (stripped of "HisaabKitaab-" prefix).
   * Used as the primary idempotency key for Tally XML re-imports.
   * Null for entries created natively in HisaabKitaab (not via Tally import).
   */
  remoteId        String? // [B5] Tally import idempotency
  /**
   * isReverseCharge — true when this entry is an RCM purchase under
   * IGST Act Section 9(3) / 9(4). Emitted as <ISREVERSECHARGE>Yes</ISREVERSECHARGE>
   * in Tally XML so GSTR-3B ITC columns are correctly populated.
   */
  isReverseCharge Boolean       @default(false) // [P1] RCM flag for GSTR-3B
  createdBy       String
  createdAt       DateTime      @default(now())
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  bill            Bill?         @relation(fields: [billId], references: [id])
  lines           JournalLine[]

  @@unique([tenantId, remoteId]) // [B5] partial unique — DB enforces no duplicate Tally imports per tenant
  @@index([tenantId])
  @@index([tenantId, entryDate])
  @@index([tenantId, voucherType])
  @@index([billId])
  @@index([purchaseId])
  @@index([paymentId])
}

model JournalLine {
  id          String       @id @default(cuid())
  journalId   String
  accountCode String
  accountName String
  tallyGroup  String
  partyId     String?
  partyName   String?
  debit       Decimal      @default(0) @db.Decimal(19, 4) // [B4] Float → Decimal for precision
  credit      Decimal      @default(0) @db.Decimal(19, 4) // [B4] Float → Decimal for precision
  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([accountCode])
}

model MediaAsset {
  id                String             @id @default(cuid())
  kind              MediaAssetKind
  storageProvider   String
  storageKey        String             @unique
  mimeType          String
  bytes             Int
  originalName      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  measurementPhotos MeasurementPhoto[]
}

model MeasurementPhoto {
  id            String            @id @default(cuid())
  measurementId String
  assetId       String
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  asset         MediaAsset        @relation(fields: [assetId], references: [id])
  measurement   MeasurementUpload @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId, sortOrder])
  @@index([assetId])
}

model MeasurementUpload {
  id           String             @id @default(cuid())
  customerId   String
  label        String
  roomName     String?
  doorType     String?
  notes        String?
  photosLegacy Json               @map("photos")
  status       MeasurementStatus  @default(UPLOADED)
  reviewedBy   String?
  reviewNotes  String?
  isDeleted    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  partyId      String?
  tenantId     String
  photoAssets  MeasurementPhoto[]
  customer     User               @relation(fields: [customerId], references: [id])
  party        Party?             @relation(fields: [partyId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum TenantPlan {
  FREE
  PRO
}

enum Role {
  ADMIN
  STAFF
  ACCOUNTANT
  CUSTOMER
}

enum AuthThrottleScope {
  IP
  CREDENTIAL
}

enum BillStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum SyncState {
  SYNCED
  MODIFIED
  PENDING
}

enum PartyType {
  VENDOR
  CUSTOMER
}

enum PayDirection {
  INCOMING
  OUTGOING
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  EXPECTED
  COMPLETED
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
  CREDIT_NOTE // GST Credit Note — reversal of a FINAL sales bill (GSTR-1 Table 9B)
  DEBIT_NOTE // GST Debit Note — Purchase Return under IGST Act (GSTR-3B Table 4)
  CONTRA // Bank-to-cash transfers (native Tally type) [X4]
}

enum MediaAssetKind {
  COMPANY_LOGO
  MEASUREMENT_PHOTO
}

enum ActorType {
  USER // Human user via UI or API
  SYSTEM // Automated: cron jobs, Tally imports, background tasks
}

enum MeasurementStatus {
  UPLOADED
  PENDING
  REVIEWED
  IN_PRODUCTION
  COMPLETED
}

model ImportJob {
  id         String    @id @default(cuid())
  tenantId   String
  createdBy  String?   // User ID of the admin who initiated the import (used for Bill FK)
  status     JobStatus @default(PENDING) // PENDING, PROCESSING, COMPLETED, FAILED
  totalItems Int       @default(0)
  processed  Int       @default(0)
  failed     Int       @default(0)
  xmlData    String    @db.Text
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
