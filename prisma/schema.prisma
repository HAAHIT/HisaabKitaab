generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  phone                String?
  email                String?
  address              String?
  gstin                String?
  logoUrl              String?
  plan                 TenantPlan          @default(FREE)
  settings             Json                @default("{}")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  isOnboardingComplete Boolean?            @default(false)

  // ── Billing / Quota tracking ─────────────────────────────────────────────
  // trialEndsAt: null = no trial taken; future date = trial active
  trialEndsAt          DateTime?
  // planExpiresAt: when the current paid plan expires (null for FREE)
  planExpiresAt        DateTime?
  subscriptionStatus   SubscriptionStatus  @default(ACTIVE)
  // Razorpay identifiers — null for FREE tenants
  razorpayCustomerId   String?
  razorpaySubscriptionId String?
  // Monthly usage counters (reset by usageWindowStart rollover)
  monthlyBillCount     Int                 @default(0)
  monthlyPartyCount    Int                 @default(0)
  usageWindowStart     DateTime            @default(now())
  // Reminder language for WhatsApp reminders: "hinglish" | "hindi" | "english"
  reminderLanguage     String              @default("hinglish")
  subscriptionEvents   SubscriptionEvent[]
  auditLogs            AuditLog[]
  BankAccount          BankAccount[]
  bills                Bill[]
  templates            BillTemplate[]
  importJobs           ImportJob[]
  items                ItemCatalog[]
  journalEntries       JournalEntry[]
  measurements         MeasurementUpload[]
  parties              Party[]
  payments             Payment[]
  users                User[]
  bankStatements       BankStatement[]
}

model User {
  id            String              @id @default(cuid())
  name          String
  email         String?
  phone         String?
  password      String
  role          Role                @default(CUSTOMER)
  isActive      Boolean             @default(true)
  createdBy     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenantId      String
  authThrottles AuthThrottle[]
  billsCreated  Bill[]
  measurements  MeasurementUpload[]
  payments      Payment[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model ApiRateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  id             String            @id @default(cuid())
  scope          AuthThrottleScope
  throttleKey    String
  userId         String?
  failureCount   Int               @default(0)
  firstFailureAt DateTime?
  lastAttemptAt  DateTime?
  blockedUntil   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User?             @relation(fields: [userId], references: [id])

  @@unique([scope, throttleKey])
  @@index([blockedUntil])
  @@index([userId])
}

/// *
///  * AuditLog — MCA-mandated Edit Log (GSR 247(E), effective April 1 2023)
///  * Append-only: rows are NEVER updated or deleted.
///  * Captures every CREATE / UPDATE / DELETE on accounting-relevant entities.
///  * Indexed for tenant-scoped audit queries and date-range exports.
model AuditLog {
  id         String    @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  userId     String?
  action     String
  fieldName  String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime  @default(now())
  actorType  ActorType @default(USER)
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

model BillTemplate {
  id        String   @id @default(cuid())
  name      String
  columns   Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  tenantId  String
  bills     Bill[]
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ItemCatalog {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  hsnCode   String?
  unit      String   @default("pcs")
  rate      Decimal  @default(0) @db.Decimal(19, 4)
  taxRate   Decimal? @db.Decimal(5, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cessRate  Decimal? @db.Decimal(5, 2)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, name])
}

model Bill {
  id              String         @id @default(cuid())
  billNumber      String
  templateId      String
  customerName    String
  customerPhone   String?
  customerAddress String?
  gstin           String?
  rows            Json
  notes           String?
  terms           String?
  subtotal        Decimal        @db.Decimal(19, 4)
  taxPercent      Decimal        @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(19, 4)
  grandTotal      Decimal        @db.Decimal(19, 4)
  status          BillStatus     @default(DRAFT)
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isDeleted       Boolean        @default(false)
  partyId         String?
  tenantId        String
  isInterState    Boolean        @default(false)
  placeOfSupply   String?
  cessAmount      Decimal        @default(0) @db.Decimal(19, 4)
  hsnCode         String?
  date            DateTime       @default(now())
  roundOff        Decimal        @default(0) @db.Decimal(19, 4)
  shippingAddress String?
  creator         User           @relation(fields: [createdBy], references: [id])
  party           Party?         @relation(fields: [partyId], references: [id])
  template        BillTemplate   @relation(fields: [templateId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  journalEntries  JournalEntry[]
  payments        Payment[]

  @@unique([tenantId, billNumber])
  @@index([tenantId])
  @@index([tenantId, partyId])
  @@index([tenantId, status])
}

model Party {
  id             String              @id @default(cuid())
  name           String
  type           PartyType
  phone          String?
  email          String?
  address        String?
  gstin          String?
  openingBalance Decimal             @default(0) @db.Decimal(19, 4)
  currentBalance Decimal             @default(0) @db.Decimal(19, 4)
  isActive       Boolean             @default(true)
  isDeleted      Boolean             @default(false)
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenantId       String
  bills          Bill[]
  measurements   MeasurementUpload[]
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  payments       Payment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, type])
}

model Payment {
  id                                                    String        @id @default(cuid())
  partyId                                               String?
  direction                                             PayDirection
  amount                                                Decimal       @db.Decimal(19, 4)
  date                                                  DateTime
  mode                                                  PaymentMode
  status                                                PaymentStatus @default(COMPLETED)
  referenceNo                                           String?
  linkedBillId                                          String?
  notes                                                 String?
  receiptUrl                                            String?
  createdBy                                             String
  createdAt                                             DateTime      @default(now())
  isDeleted                                             Boolean       @default(false)
  updatedAt                                             DateTime      @updatedAt
  reconciledAt                                          DateTime?
  tenantId                                              String
  accountId                                             String?
  destinationAccountId                                  String?
  BankAccount_Payment_accountIdToBankAccount            BankAccount?  @relation("Payment_accountIdToBankAccount", fields: [accountId], references: [id])
  creator                                               User          @relation(fields: [createdBy], references: [id])
  BankAccount_Payment_destinationAccountIdToBankAccount BankAccount?  @relation("Payment_destinationAccountIdToBankAccount", fields: [destinationAccountId], references: [id])
  linkedBill                                            Bill?         @relation(fields: [linkedBillId], references: [id])
  party                                                 Party?        @relation(fields: [partyId], references: [id])
  tenant                                                Tenant        @relation(fields: [tenantId], references: [id])
  bankStatementRows                                     BankStatementRow[]

  @@index([tenantId])
  @@index([tenantId, partyId])
  @@index([tenantId, direction])
  @@index([tenantId, accountId])
  @@index([tenantId, destinationAccountId])
}

model JournalEntry {
  id              String        @id @default(cuid())
  tenantId        String
  entryDate       DateTime
  narration       String
  voucherType     VoucherType
  billId          String?
  purchaseId      String?
  paymentId       String?
  isBalanced      Boolean       @default(false)
  totalDebit      Decimal       @default(0) @db.Decimal(19, 4)
  totalCredit     Decimal       @default(0) @db.Decimal(19, 4)
  createdBy       String
  createdAt       DateTime      @default(now())
  /// *
  ///    * remoteId — Tally <REMOTEID> / <GUID> value (stripped of "SoloBooks-" prefix).
  ///    * Used as the primary idempotency key for Tally XML re-imports.
  ///    * Null for entries created natively in SoloBooks (not via Tally import).
  remoteId        String?
  /// *
  ///    * isReverseCharge — true when this entry is an RCM purchase under
  ///    * IGST Act Section 9(3) / 9(4). Emitted as <ISREVERSECHARGE>Yes</ISREVERSECHARGE>
  ///    * in Tally XML so GSTR-3B ITC columns are correctly populated.
  isReverseCharge Boolean       @default(false)
  syncState       SyncState     @default(SYNCED)
  isDeleted       Boolean       @default(false)
  bill            Bill?         @relation(fields: [billId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  lines           JournalLine[]

  @@unique([tenantId, remoteId])
  @@index([tenantId])
  @@index([tenantId, entryDate])
  @@index([tenantId, voucherType])
  @@index([billId])
  @@index([purchaseId])
  @@index([paymentId])
  @@index([tenantId, isDeleted])
}

model JournalLine {
  id          String       @id @default(cuid())
  journalId   String
  accountCode String
  accountName String
  tallyGroup  String
  partyId     String?
  partyName   String?
  debit       Decimal      @default(0) @db.Decimal(19, 4)
  credit      Decimal      @default(0) @db.Decimal(19, 4)
  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([accountCode])
}

model MediaAsset {
  id                String             @id @default(cuid())
  kind              MediaAssetKind
  storageProvider   String
  storageKey        String             @unique
  mimeType          String
  bytes             Int
  originalName      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  measurementPhotos MeasurementPhoto[]
}

model MeasurementPhoto {
  id            String            @id @default(cuid())
  measurementId String
  assetId       String
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  asset         MediaAsset        @relation(fields: [assetId], references: [id])
  measurement   MeasurementUpload @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId, sortOrder])
  @@index([assetId])
}

model MeasurementUpload {
  id           String             @id @default(cuid())
  customerId   String
  label        String
  roomName     String?
  doorType     String?
  notes        String?
  photosLegacy Json               @map("photos")
  status       MeasurementStatus  @default(UPLOADED)
  reviewedBy   String?
  reviewNotes  String?
  isDeleted    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  partyId      String?
  tenantId     String
  photoAssets  MeasurementPhoto[]
  customer     User               @relation(fields: [customerId], references: [id])
  party        Party?             @relation(fields: [partyId], references: [id])
  tenant       Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ImportJob {
  id             String    @id @default(cuid())
  tenantId       String
  status         JobStatus @default(PENDING)
  totalItems     Int       @default(0)
  processed      Int       @default(0)
  failed         Int       @default(0)
  skipped        Int       @default(0)
  xmlData        String
  error          String?
  /// Array of { voucherType, narration, entryDate, reason } objects for per-voucher
  /// failure inspection. Populated by process-import worker.
  failures       Json?
  /// Array of { voucherType, narration, entryDate, imbalance } objects captured
  /// every time the import absorbed a Tally rounding imbalance into ROUND_OFF.
  /// Lets CAs audit exactly what was patched, since the journal stores only the
  /// balanced result. Capped at 100 entries to bound row size.
  roundOffAdjustments Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  stage          String    @default("queued")
  partiesCreated Int       @default(0)
  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BankAccount {
  id                                                String      @id @default(cuid())
  tenantId                                          String
  name                                              String
  type                                              AccountType
  accountNumber                                     String?
  ifscCode                                          String?
  openingBalance                                    Decimal     @default(0) @db.Decimal(19, 4)
  currentBalance                                    Decimal     @default(0) @db.Decimal(19, 4)
  isActive                                          Boolean     @default(true)
  isDefault                                         Boolean     @default(false)
  isDeleted                                         Boolean     @default(false)
  createdBy                                         String?
  createdAt                                         DateTime    @default(now())
  updatedAt                                         DateTime
  Tenant                                            Tenant      @relation(fields: [tenantId], references: [id])
  Payment_Payment_accountIdToBankAccount            Payment[]   @relation("Payment_accountIdToBankAccount")
  Payment_Payment_destinationAccountIdToBankAccount Payment[]   @relation("Payment_destinationAccountIdToBankAccount")
  bankStatements                                    BankStatement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, type])
}

enum TenantPlan {
  FREE
  PRO
  PRO_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ── §Billing ─ Subscription event audit log ───────────────────────────────
// Every Razorpay webhook + manual plan change is recorded here as an
// append-only audit log, so we can always reconstruct billing history.
model SubscriptionEvent {
  id             String   @id @default(cuid())
  tenantId       String
  eventType      String   // "subscription.activated", "payment.captured", "manual.upgrade", etc.
  fromPlan       TenantPlan?
  toPlan         TenantPlan?
  amount         Int?     // paise
  razorpayId     String?  // payment_id / subscription_id reference
  // Composite idempotency key = "<eventType>:<razorpayId>:<paymentId|none>"
  // DB-unique so concurrent duplicate webhooks hit a constraint violation instead of
  // racing through the application-level dedup check (TOCTOU fix).
  idempotencyKey String?  @unique
  payload        Json?    // full webhook payload for forensics
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([razorpayId])
}

enum Role {
  ADMIN
  STAFF
  ACCOUNTANT
  CUSTOMER
  SUPERADMIN
}

enum AuthThrottleScope {
  IP
  CREDENTIAL
}

enum BillStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum SyncState {
  SYNCED
  MODIFIED
  PENDING
}

enum PartyType {
  VENDOR
  CUSTOMER
  EXPENSE
  INCOME
  ASSET
  LIABILITY
  EQUITY
}

enum PayDirection {
  INCOMING
  OUTGOING
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  EXPECTED
  COMPLETED
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
  CREDIT_NOTE
  DEBIT_NOTE
  CONTRA
}

enum MediaAssetKind {
  COMPANY_LOGO
  MEASUREMENT_PHOTO
}

enum ActorType {
  USER
  SYSTEM
}

enum MeasurementStatus {
  UPLOADED
  PENDING
  REVIEWED
  IN_PRODUCTION
  COMPLETED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AccountType {
  BANK
  CASH
}

// ── §5.10 Bank Reconciliation ─────────────────────────────────────────────────

enum BankRowStatus {
  PENDING
  AUTO_MATCHED
  MANUALLY_CATEGORIZED
  IGNORED
  AMBIGUOUS
}

model BankStatement {
  id             String             @id @default(cuid())
  tenantId       String
  bankAccountId  String
  periodFrom     DateTime
  periodTo       DateTime
  uploadedAt     DateTime           @default(now())
  rowCount       Int
  matchedCount   Int                @default(0)
  unmatchedCount Int                @default(0)
  isReconciled   Boolean            @default(false)
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  bankAccount    BankAccount        @relation(fields: [bankAccountId], references: [id])
  rows           BankStatementRow[]

  @@index([tenantId])
  @@index([tenantId, bankAccountId])
}

model BankStatementRow {
  id               String         @id @default(cuid())
  tenantId         String
  statementId      String
  date             DateTime
  description      String
  amount           Decimal        @db.Decimal(19, 4)
  direction        PayDirection
  rawLine          String
  matchedPaymentId String?
  status           BankRowStatus  @default(PENDING)
  category         String?
  statement        BankStatement  @relation(fields: [statementId], references: [id])
  matchedPayment   Payment?       @relation(fields: [matchedPaymentId], references: [id])

  @@index([tenantId])
  @@index([statementId])
  @@unique([statementId, date, amount, description])
}
