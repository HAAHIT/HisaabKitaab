// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  ACCOUNTANT
  CUSTOMER
}

enum AuthThrottleScope {
  IP
  CREDENTIAL
}

enum BillStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum PartyType {
  VENDOR
  CUSTOMER
}

enum PayDirection {
  INCOMING
  OUTGOING
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  EXPECTED
  COMPLETED
}

enum MediaAssetKind {
  COMPANY_LOGO
  MEASUREMENT_PHOTO
}

enum MeasurementStatus {
  UPLOADED
  PENDING
  REVIEWED
  IN_PRODUCTION
  COMPLETED
}



